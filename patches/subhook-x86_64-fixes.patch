 #include "subhook.h"
 #include "subhook_private.h"
 
+#if defined SUBHOOK_X86_64 && defined SUBHOOK_UNIX
+#include <stdint.h>
+#include <unistd.h>
+#include <sys/mman.h>
+
+/* sbpe: on x86_64 the trampoline must be within +-2GB of the source,
+ * otherwise rel32 calls/jumps and RIP-relative operands copied from the
+ * prologue cannot be relocated (heap memory is usually much further away,
+ * e.g. on macOS). Map a page close to the source instead of using calloc.
+ */
+#define SUBHOOK_NEAR_RANGE 0x7ff00000L
+
+static void *subhook_alloc_near(void *src, size_t size) {
+  uintptr_t pagesize = (uintptr_t)sysconf(_SC_PAGESIZE);
+  uintptr_t base = (uintptr_t)src & ~(pagesize - 1);
+  uintptr_t d;
+  int sign;
+
+  if (size > pagesize) {
+    return NULL;
+  }
+  for (d = 0x100000; d < (uintptr_t)SUBHOOK_NEAR_RANGE; d += 0x100000) {
+    for (sign = 0; sign < 2; sign++) {
+      uintptr_t hint;
+      void *p;
+      if (sign == 0) {
+        if (base < d) continue;
+        hint = base - d;
+      } else {
+        hint = base + d;
+      }
+      p = mmap((void *)hint, pagesize, PROT_READ | PROT_WRITE | PROT_EXEC,
+               MAP_PRIVATE | MAP_ANON, -1, 0);
+      if (p == MAP_FAILED) {
+        continue;
+      }
+      if ((intptr_t)p - (intptr_t)src < SUBHOOK_NEAR_RANGE
+          && (intptr_t)src - (intptr_t)p < SUBHOOK_NEAR_RANGE) {
+        memset(p, 0, pagesize);
+        return p;
+      }
+      munmap(p, pagesize);
+    }
+  }
+  return NULL;
+}
+
+static void subhook_free_near(void *p) {
+  if (p != NULL) {
+    munmap(p, (size_t)sysconf(_SC_PAGESIZE));
+  }
+}
+#define SUBHOOK_TRAMPOLINE_ALLOC(src, size) subhook_alloc_near((src), (size))
+#define SUBHOOK_TRAMPOLINE_FREE(p) subhook_free_near(p)
+#else
+#define SUBHOOK_TRAMPOLINE_ALLOC(src, size) calloc(1, (size))
+#define SUBHOOK_TRAMPOLINE_FREE(p) free(p)
+#endif
+
